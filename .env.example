# Ollama task-breakdown model server (download with `ollama pull llama3.2:1b`).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000
API_PORT=3001
ALLOWED_WEB_ORIGIN=http://localhost:8081

# Frontend: keep this in .env.local and include it only if the API is not local.
EXPO_PUBLIC_API_URL=http://localhost:3001
