# Server-only: never expose this value through an EXPO_PUBLIC_* variable.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
API_PORT=3001
ALLOWED_WEB_ORIGIN=http://localhost:8081

# Frontend: keep this in .env.local and include it only if the API is not local.
EXPO_PUBLIC_API_URL=http://localhost:3001
